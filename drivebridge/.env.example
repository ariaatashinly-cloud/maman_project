# BotFather token; treat this as a password.
TELEGRAM_BOT_TOKEN=
# Your numeric Telegram user ID (send /id to the bot first).
TELEGRAM_OWNER_ID=
# From my.telegram.org -> API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Google Cloud -> OAuth Client ID, application type Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: an existing folder in your Drive. The app needs access to it.
GOOGLE_FOLDER_ID=
# HTTPS hostname pointed to the Cloudflare Tunnel; no trailing slash.
PUBLIC_BASE_URL=https://files.example.com
ADMIN_PASSWORD=
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Browser upload maximum. Keep enough temporary disk space for this size.
MAX_UPLOAD_GB=5
# Only needed with --profile tunnel
CF_TUNNEL_TOKEN=
